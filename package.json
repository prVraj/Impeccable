    "start": "next start",
    "registry:build": "node scripts/build-js.mjs && shadcn build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "16.0.11",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "shiki": "3.23.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "prettier": "3.9.10",
    "shadcn": "3.8.5",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.34.9",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ],
